# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_PORT=5000

# MongoDB Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB_NAME=finance_advisor

# MATLAB Configuration
# Set to true if MATLAB is installed and configured
MATLAB_AVAILABLE=false

# Options: "engine" (MATLAB Engine for Python) or "batch" (command-line execution)
MATLAB_ENGINE_MODE=batch

# Path to MATLAB executable (for batch mode)
# Windows example: C:\Program Files\MATLAB\R2023a\bin\matlab.exe
# Leave empty to use system PATH
MATLAB_PATH=

# Twilio SMS Configuration (Optional)
# Get credentials from: https://console.twilio.com/
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
USER_PHONE_NUMBER=+919876543210

# ML Configuration
ML_TRAINING_MIN_SAMPLES=50
ML_MODEL_DIR=./ml/saved_models/

# Reports Configuration
REPORTS_OUTPUT_DIR=./reports/output/

# Optional: RAG Assistant Configuration (Phase 9)
RAG_ENABLED=false
OPENAI_API_KEY=sk-your-openai-api-key-here
RAG_MODEL=gpt-3.5-turbo
RAG_TEMPERATURE=0.7
RAG_MAX_TOKENS=500

# Logging
LOG_LEVEL=INFO
