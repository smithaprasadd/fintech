# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-for-college-project
FLASK_PORT=5000

# MongoDB Configuration
# Using local MongoDB for development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=finance_advisor

# MATLAB Configuration
# Set to true after verifying MATLAB installation
MATLAB_AVAILABLE=false
MATLAB_ENGINE_MODE=batch
MATLAB_PATH=

# Twilio SMS Configuration (Optional)
# Enable after getting Twilio credentials
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

# ML Configuration
ML_TRAINING_MIN_SAMPLES=50
ML_MODEL_DIR=./ml/saved_models/

# Reports Configuration
REPORTS_OUTPUT_DIR=./reports/output/

# Optional: RAG Assistant Configuration
RAG_ENABLED=false
OPENAI_API_KEY=
RAG_MODEL=gpt-3.5-turbo
RAG_TEMPERATURE=0.7
RAG_MAX_TOKENS=500

# Logging
LOG_LEVEL=INFO
